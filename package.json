{
  "name": "dsh-workspace",
  "version": "0.1.3-dsh021rc3.0",
  "type": "module",
  "description": "A session-aware progress and plugin workspace for DeepSeek Harness.",
  "repository": {
    "type": "git",
    "url": "https://github.com/AAAholic/dsh-workspace.git"
  },
  "homepage": "https://github.com/AAAholic/dsh-workspace#readme",
  "bugs": {
    "url": "https://github.com/AAAholic/dsh-workspace/issues"
  },
  "main": "lib/index.mjs",
  "exports": {
    ".": "./lib/index.mjs",
    "./client": "./lib/client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md",
    "LOCAL-SOURCE.json",
    "LICENSE"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web"
    }
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "check": "node scripts/build.mjs --check",
    "test": "node --test tests/*.test.mjs"
  },
  "devDependencies": {
    "esbuild": "0.28.1"
  },
  "peerDependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    },
    "react-dom": {
      "optional": true
    }
  },
  "license": "MIT",
  "engines": {
    "dsh": "0.2.1-rc.2 || 0.2.1-rc.3"
  },
  "private": true
}
